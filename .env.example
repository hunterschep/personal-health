# Host-side connection used by pnpm commands. Compose gives containers an
# internal db-host URL built from the POSTGRES_* values below.
DATABASE_URL=postgresql://carecadence:carecadence@localhost:5432/carecadence
# Required. Generate with: openssl rand -base64 48. Changing it invalidates sessions.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
# Local HTTP only. Set true whenever APP_BASE_URL uses HTTPS.
SESSION_COOKIE_SECURE=false

# Public origin used for links and calendar exports. Use HTTPS in production.
APP_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Docker database settings. Use a long random password outside local development.
POSTGRES_USER=carecadence
POSTGRES_PASSWORD=carecadence
POSTGRES_DB=carecadence
POSTGRES_PORT=5432
APP_PORT=3000
BUILD_VERSION=development

# Core medical logic works without external sync.
SOURCE_SYNC_ENABLED=false
SOURCE_STALE_DAYS=180

# Synthetic demo data. Disable in production unless credentials are replaced.
DEMO_SEED_ENABLED=true
DEMO_USER_EMAIL=demo@carecadence.local
DEMO_USER_PASSWORD=carecadence-demo-only
DEFAULT_TIMEZONE=America/New_York

# Optional SMTP for email verification, password reset, and reminder delivery.
# Leave every value blank for local registration, administrator recovery, and in-app reminders.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_OVERDUE_SNOOZE_MAX_DAYS=31

# Optional. Enables the protected HTTP cron route; CLI cron remains preferred.
# Generate with: openssl rand -base64 48
REMINDER_DISPATCH_SECRET=

AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
SESSION_DURATION_DAYS=30
LOG_LEVEL=info
