{
  "name": "carecadence",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset",
    "sources:verify": "tsx scripts/verify-sources.ts",
    "sources:sync": "tsx scripts/sync-myhealthfinder.ts",
    "sources:report": "tsx scripts/source-report.ts",
    "sources:review": "tsx scripts/review-source-content.ts",
    "rules:validate": "tsx scripts/validate-rules.ts",
    "rules:diff": "tsx scripts/diff-rules.ts",
    "recommendations:rebuild": "tsx scripts/rebuild-recommendations.ts",
    "reminders:dispatch": "tsx scripts/dispatch-reminders.ts",
    "storage:cleanup": "tsx scripts/cleanup-deleted-documents.ts",
    "account:recover": "tsx scripts/recover-account.ts",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm sources:verify && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@hookform/resolvers": "5.4.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "argon2": "0.45.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "file-type": "22.0.1",
    "jose": "6.2.3",
    "jszip": "3.10.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "nodemailer": "9.0.1",
    "papaparse": "5.5.4",
    "pg": "8.22.0",
    "radix-ui": "1.6.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "sanitize-filename": "1.6.4",
    "sanitize-html": "2.17.6",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-playwright": "2.10.5",
    "eslint-plugin-testing-library": "7.16.2",
    "jsdom": "29.1.1",
    "postcss": "8.5.21",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
